# ─── CarValuator Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your API keys.

# Gemini API Key (Google AI Studio — free tier available)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# RapidAPI Key (for Vehicle RC Information API)
# 1. Sign up free at https://rapidapi.com
# 2. Subscribe to "Vehicle RC Information" API (free tier):
#    https://rapidapi.com/fatehbrar92/api/vehicle-rc-information
# 3. Copy your API key from the dashboard
RAPIDAPI_KEY=your_rapidapi_key_here
