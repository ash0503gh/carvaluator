# ─── CarValuator Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your API keys.

# Gemini API Key (Google AI Studio — free tier available)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# RapidAPI Key (for RTO Vehicle Information India API)
# 1. Sign up free at https://rapidapi.com
# 2. Subscribe to "RTO Vehicle Information India" by eccentriclabs (free tier):
#    https://rapidapi.com/streamifyworld/api/rto-vehicle-information-india
# 3. Copy your API key from the dashboard
# NOTE: If you previously shared this key anywhere (screenshots, chat, etc.),
# regenerate it from your RapidAPI dashboard before deploying.
RAPIDAPI_KEY=your_rapidapi_key_here
